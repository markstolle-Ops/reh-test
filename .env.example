NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
# Clerk frontend API domain for CSP (e.g., "https://your-app.clerk.accounts.dev")
NEXT_PUBLIC_CLERK_DOMAIN=
DATABASE_URL=

# MANUAL STEP: In Clerk Dashboard > Sessions > Edit JWT template,
# add claim: { "role": "{{user.public_metadata.role}}" }
# Role-based routing will not work until this is done.

# ─── Cloudflare R2 (photo storage) ───────────────────────────────────────────
R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
# Public URL prefix for serving photos (e.g. https://pub-xxxxx.r2.dev)
R2_PUBLIC_URL=

# ─── OpenAI (listing description generation + embeddings) ────────────────────
OPENAI_API_KEY=

# ─── Inngest (async job queue) ────────────────────────────────────────────────
# Required in production; optional for local dev (dev server provides them)
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

# ─── SimplyRETS (MLS listing ingestion) ───────────────────────────────────────
# Use demo credentials for development: simplyrets / simplyrets
# Production requires a signed IDX agreement with each MLS board.
SIMPLYRETS_API_KEY=simplyrets
SIMPLYRETS_API_SECRET=simplyrets

# ─── Mapbox (interactive map view on buyer search page) ───────────────────────
# Get your public token from https://account.mapbox.com/
# Must start with "pk." — this is safe to expose in the browser bundle.
NEXT_PUBLIC_MAPBOX_TOKEN=

# ─── SignWell (eSignature / E-SIGN Act compliant digital signing) ─────────────
# Get your API key from https://www.signwell.com/app/settings/integrations
# Uses test_mode=true automatically in non-production environments.
SIGNWELL_API_KEY=

# ─── Resend (transactional email) ─────────────────────────────────────────────
# Get your API key from https://resend.com/api-keys
RESEND_API_KEY=
# From address for outbound emails (must be a verified domain in Resend)
RESEND_FROM_EMAIL=noreply@realestatehunter.com

# ─── MLS Broker Partner (flat-fee MLS syndication) ────────────────────────────
# Email for flat-fee MLS broker partner (e.g., ListWithFreedom) — required for MLS syndication
# Set to broker's listing intake email address before going to production.
MLS_BROKER_EMAIL=
